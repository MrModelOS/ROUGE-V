// ROUGE-V canonical kernel: signed vs unsigned comparisons.
//
// This kernel exists because of a real bug: the AOT lowering picked the icmp
// kind by the CONDITION only ("lt" -> "ult") and ignored the signedness from
// the type suffix, so every setp.lt.s32 was compiled as an UNSIGNED
// comparison. The interpreter did the right thing, the card did what the IR
// said — and the two disagreed on any negative operand. The differential
// fuzzer found it; this kernel keeps it found.
//
// For every element i it stores four results:
//   out[4i+0] = (in[i] <  seed)  ? 1 : 0   signed   (setp.lt.s32)
//   out[4i+1] = (in[i] <u seed)  ? 1 : 0   unsigned (setp.lt.u32)
//   out[4i+2] = (in[i] >= seed)  ? 1 : 0   signed   (setp.ge.s32)
//   out[4i+3] = (in[i] >=u seed)  ? 1 : 0   unsigned (setp.ge.u32)
// With negative inputs the signed and the unsigned answers differ, so a
// lowering that confuses them is visible immediately.

.version 8.0
.target sm_75
.address_size 64

.visible .entry cmp_signed(
    .param .u64 cmp_signed_param_0,
    .param .u64 cmp_signed_param_1,
    .param .u32 cmp_signed_param_2,
    .param .u32 cmp_signed_param_3
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [cmp_signed_param_0];
    ld.param.u64 %rd2, [cmp_signed_param_1];
    ld.param.u32 %r1, [cmp_signed_param_2];
    ld.param.u32 %r2, [cmp_signed_param_3];
    cvta.to.global.u64 %rd3, %rd1;
    cvta.to.global.u64 %rd4, %rd2;

    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mul.wide.u32 %rd5, %r3, %r4;
    mov.u32 %r6, %tid.x;
    cvt.u64.u32 %rd6, %r6;
    add.s64 %rd5, %rd5, %rd6;
    cvt.u32.u64 %r5, %rd5;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra $L_out;

    mul.wide.u32 %rd7, %r5, 4;
    add.s64 %rd4, %rd4, %rd7;
    ld.global.s32 %r7, [%rd4];
    mov.u32 %r8, %r2;

    setp.lt.s32 %p2, %r7, %r8;
    selp.s32 %r9, 1, 0, %p2;
    setp.lt.u32 %p3, %r7, %r8;
    selp.s32 %r10, 1, 0, %p3;
    setp.ge.s32 %p2, %r7, %r8;
    selp.s32 %r11, 1, 0, %p2;
    setp.ge.u32 %p3, %r7, %r8;
    selp.s32 %r12, 1, 0, %p3;

    // out[4*i + k]
    mul.lo.s32 %r14, %r5, 4;
    mul.wide.u32 %rd6, %r14, 4;
    add.s64 %rd6, %rd6, %rd3;
    st.global.s32 [%rd6], %r9;
    add.s64 %rd6, %rd6, 4;
    st.global.s32 [%rd6], %r10;
    add.s64 %rd6, %rd6, 4;
    st.global.s32 [%rd6], %r11;
    add.s64 %rd6, %rd6, 4;
    st.global.s32 [%rd6], %r12;

$L_out:
    ret;
}
