.version 8.0
.target sm_80
.address_size 64

// Foreign-PTX probe: .volatile-qualified shared accesses plus generic
// (space-less) global ld/st. Tier-0 only: translation + assembly.

.visible .entry probe_volatile(
    .param .u64 probe_volatile_param_0,
    .param .u64 probe_volatile_param_1,
    .param .u32 probe_volatile_param_2
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<6>;
    .reg .pred %p<2>;
    .shared .align 4 .b32 tile[32];

    ld.param.u64 %rd1, [probe_volatile_param_0];
    ld.param.u64 %rd2, [probe_volatile_param_1];
    ld.param.u32 %r1, [probe_volatile_param_2];

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mul.wide.u32 %rd3, %r2, %r3;
    mov.u32 %r4, %tid.x;
    cvt.u64.u32 %rd4, %r4;
    add.s64 %rd3, %rd3, %rd4;
    cvt.u32.u64 %r5, %rd3;

    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra L_RET;

    mul.wide.u32 %rd4, %r5, 4;
    add.s64 %rd1, %rd1, %rd4;
    ld.u32 %r6, [%rd1];

    mul.wide.u32 %rd4, %r4, 4;
    cvta.to.shared.u64 %rd5, tile;
    add.s64 %rd5, %rd5, %rd4;
    st.volatile.shared.u32 [%rd5], %r6;
    ld.volatile.shared.u32 %r7, [%rd5];

    add.s64 %rd2, %rd2, %rd4;
    st.u32 [%rd2], %r7;

L_RET:
    ret;
}
