.version 8.0
.target sm_80
.address_size 64

// Foreign-PTX probe: unsized .extern .shared (dynamic shared) addressed via
// mov.u32 and bare-symbol ld/st.shared. Tier-0 only: translation + assembly
// (execution needs launch-sized dynamic backing, provided by the runner).

.extern .shared .align 4 .b32 __dyn[];

.visible .entry probe_dynshared(
    .param .u64 probe_dynshared_param_0,
    .param .u64 probe_dynshared_param_1,
    .param .u32 probe_dynshared_param_2
)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<6>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [probe_dynshared_param_0];
    ld.param.u64 %rd2, [probe_dynshared_param_1];
    ld.param.u32 %r1, [probe_dynshared_param_2];

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mul.wide.u32 %rd3, %r2, %r3;
    mov.u32 %r4, %tid.x;
    cvt.u64.u32 %rd4, %r4;
    add.s64 %rd3, %rd3, %rd4;
    cvt.u32.u64 %r5, %rd3;

    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra L_RET;

    mul.wide.u32 %rd4, %r5, 4;
    add.s64 %rd1, %rd1, %rd4;
    ld.global.u32 %r6, [%rd1];

    mov.u32 %r7, __dyn;
    st.shared.u32 [%r7], %r6;
    ld.shared.u32 %r8, [__dyn];

    add.u32 %r9, %r6, %r8;
    add.s64 %rd2, %rd2, %rd4;
    st.global.u32 [%rd2], %r9;

L_RET:
    ret;
}
