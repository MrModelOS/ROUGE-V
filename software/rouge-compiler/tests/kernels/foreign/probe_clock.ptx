.version 8.0
.target sm_80
.address_size 64

// Foreign-PTX probe: %clock64. NVPTX reads the real hardware counter;
// the host has no equivalent (CPU time is not GPU cycles), so the host
// target must FAIL LOUDLY here instead of wiring garbage. The CI script
// asserts exactly that split.

.visible .entry probe_clock(
    .param .u64 probe_clock_param_0,
    .param .u64 probe_clock_param_1,
    .param .u32 probe_clock_param_2
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<5>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [probe_clock_param_0];
    ld.param.u64 %rd2, [probe_clock_param_1];
    ld.param.u32 %r1, [probe_clock_param_2];

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mul.wide.u32 %rd3, %r2, %r3;
    mov.u32 %r4, %tid.x;
    cvt.u64.u32 %rd4, %r4;
    add.s64 %rd3, %rd3, %rd4;
    cvt.u32.u64 %r5, %rd3;

    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra L_RET;

    mov.u64 %rd4, %clock64;
    mov.b32 %r6, %rd4;

    mul.wide.u32 %rd4, %r5, 4;
    add.s64 %rd2, %rd2, %rd4;
    st.global.b32 [%rd2], %r6;

L_RET:
    ret;
}
