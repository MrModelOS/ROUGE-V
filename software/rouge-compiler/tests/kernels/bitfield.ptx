// Bit-field instructions pinned to the PTX ISA (bfi, bfe, prmt).
//
// This kernel is NOT generated by nvcc: it is hand-written so that every
// case is a value we can compute by hand from the ISA's pseudo-code. The
// test (test_aot_bitfield.cpp) compares THREE things on the same input:
//
//   * the native code produced by ptx2ir + clang,
//   * our PTX interpreter,
//   * the ISA's pseudo-code, re-implemented in the test.
//
// Comparing the first two with each other is not enough: an earlier version
// of both read a packed selector (pos | len << 8) and inserted b into a
// instead of a into b, and the two paths agreed perfectly on the wrong
// answer. The third comparison is what catches that.
//
//   bfi.type f, a, b, c, d;   pos = c & 0xff, len = d & 0xff
//       f = b; for (i < len && pos+i <= msb) f[pos+i] = a[i];
//   bfe.type d, a, b, c;      pos = b & 0xff, len = c & 0xff
//       the field a[pos .. pos+len-1], zero/sign-extended; len == 0 -> 0.
//   prmt.b32 d, a, b, c;      mode 0: four bytes selected by the nibbles of
//       c out of the 64-bit {a,b}; a nibble with bit 3 set replicates the
//       sign bit of the selected byte.
//
// Shape: out[i*9 + j], i = thread, n threads, one input word per thread.
.version 8.0
.target sm_75
.address_size 64

.visible .entry bitfield(.param .u64 p0, .param .u64 p1, .param .u32 p2)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<2>;

    ld.param.u64 %rd1, [p0];
    ld.param.u64 %rd2, [p1];
    ld.param.u32 %r1, [p2];
    cvta.to.global.u64 %rd3, %rd1;
    cvta.to.global.u64 %rd4, %rd2;

    mov.u32 %r2, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra $L_out;

    mul.wide.u32 %rd5, %r2, 4;
    add.s64 %rd6, %rd4, %rd5;
    ld.global.u32 %r3, [%rd6];
    xor.b32 %r4, %r3, 0x5A5A5A5A;

    // The nine cases.
    bfi.b32 %r6, %r3, %r4, 3, 7;
    bfi.b32 %r7, %r3, %r4, 0, 32;
    bfi.b32 %r8, %r3, %r4, 30, 8;
    bfi.b32 %r9, %r3, %r4, 40, 4;
    bfe.u32 %r10, %r3, 5, 11;
    bfe.s32 %r11, %r3, 3, 12;
    bfe.u32 %r12, %r3, 0, 0;
    prmt.b32 %r13, %r3, %r4, 0x7140;
    prmt.b32 %r14, %r3, %r4, 0x8B7A;

    mul.lo.s32 %r5, %r2, 9;

    add.s32 %r15, %r5, 0;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r6;

    add.s32 %r15, %r5, 1;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r7;

    add.s32 %r15, %r5, 2;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r8;

    add.s32 %r15, %r5, 3;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r9;

    add.s32 %r15, %r5, 4;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r10;

    add.s32 %r15, %r5, 5;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r11;

    add.s32 %r15, %r5, 6;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r12;

    add.s32 %r15, %r5, 7;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r13;

    add.s32 %r15, %r5, 8;
    mul.wide.u32 %rd7, %r15, 4;
    add.s64 %rd7, %rd7, %rd3;
    st.global.u32 [%rd7], %r14;

$L_out:
    ret;
}
