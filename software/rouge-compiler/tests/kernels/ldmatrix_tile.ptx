// ROUGE-V canonical kernel: ldmatrix/stmatrix roundtrip (m8n8, b16).
//
// One warp (32 threads): each thread writes 2x f16 into an 8x8 input tile in
// .shared (value = row*8+col), ldmatrix.x1 the tile into a register, then
// stmatrix.x1 into an output tile, then copies its 2 elements to global.
// Non-trans must roundtrip exactly; .trans must transpose exactly.
// A second entry does the x4 variant (4 stacked 8x8 matrices).
.version 9.4
.target sm_75
.address_size 64

.visible .entry ldmatrix_tile(
    .param .u64 ldmatrix_tile_param_0
)
{
    .reg .pred %p<2>;
    .reg .b16 %h<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<4>;
    .shared .align 2 .b8 tile_in[128];
    .shared .align 2 .b8 tile_out[128];

    ld.param.u64 %rd1, [ldmatrix_tile_param_0];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.shared.u64 %rd2, tile_in;
    cvta.to.shared.u64 %rd3, tile_out;

    mov.u32 %r2, %tid.x;
    and.b32 %r3, %r2, 7;        // row = tid % 8
    shr.u32 %r4, %r2, 3;        // tid / 8
    and.b32 %r4, %r4, 3;
    shl.b32 %r4, %r4, 1;        // col0 = ((tid/8)%4)*2: 4 потока строки кроют 8 столбцов

    // fill input tile: in[row][col0..col0+1] = row*8+col (as f16)
    shl.b32 %r5, %r3, 3;        // row*8
    add.s32 %r5, %r5, %r4;      // row*8+col0
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r6, %h1;
    add.s32 %r5, %r5, 1;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r7, %h1;
    shl.b32 %r7, %r7, 16;
    or.b32 %r6, %r6, %r7;       // packed pair
    shl.b32 %r7, %r3, 4;        // row*16 bytes
    shl.b32 %r8, %r4, 1;        // col0*2 bytes
    add.s64 %rd4, %rd2, %r7;
    add.s64 %rd4, %rd4, %r8;
    st.shared.b32 [%rd4], %r6;

    bar.sync 0;

    // address of our row start (all threads provide a valid address)
    shl.b32 %r7, %r3, 4;
    add.s64 %rd5, %rd2, %r7;
    // x1 load of the whole tile (matrix 0 for every thread)
    ldmatrix.sync.aligned.m8n8.x1.shared.b16 {%r9}, [%rd5];
    // x1 store to the output tile (same row layout)
    shl.b32 %r7, %r3, 4;
    add.s64 %rd6, %rd3, %r7;
    stmatrix.sync.aligned.m8n8.x1.shared.b16 [%rd6], {%r9};

    bar.sync 0;

    // copy our 2 elements back to global: out[tid*2 + e]. The copy reads
    // the STORE positions (row tid>>2, cols (tid%4)*2), not the fill positions.
    and.b32 %r14, %r2, 3;
    shl.b32 %r14, %r14, 1;      // out-col0 = (tid%4)*2
    shr.u32 %r7, %r2, 2;        // store row = tid>>2 (group of 4 moves one row)
    shl.b32 %r7, %r7, 4;
    shl.b32 %r8, %r14, 1;
    add.s64 %rd4, %rd3, %r7;
    add.s64 %rd4, %rd4, %r8;
    ld.shared.b32 %r10, [%rd4];
    // mode 0: plain copy; mode 1: transpose check happens on host
    // (the kernel always copies; transposition is a separate entry below)
    shl.b32 %r11, %r2, 1;       // tid*2 elements
    shl.b32 %r11, %r11, 2;      // tid*8 bytes (2x f32 out)
    add.s64 %rd5, %rd1, %r11;
    // unpack the pair to two f32 stores for easy host comparison
    and.b32 %r12, %r10, 65535;
    shr.u32 %r13, %r10, 16;
    cvt.u16.u32 %h2, %r12;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r13;
    cvt.f32.f16 %f3, %h3;
    st.global.f32 [%rd5], %f2;
    st.global.f32 [%rd5+4], %f3;
    ret;
}

.visible .entry ldmatrix_trans(
    .param .u64 ldmatrix_trans_param_0
)
{
    .reg .b16 %h<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<4>;
    .shared .align 2 .b8 tile_in[128];
    .shared .align 2 .b8 tile_out[128];

    ld.param.u64 %rd1, [ldmatrix_trans_param_0];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.shared.u64 %rd2, tile_in;
    cvta.to.shared.u64 %rd3, tile_out;

    mov.u32 %r2, %tid.x;
    and.b32 %r3, %r2, 7;        // row = tid % 8
    shr.u32 %r4, %r2, 3;        // tid / 8
    and.b32 %r4, %r4, 3;
    shl.b32 %r4, %r4, 1;        // col0 = ((tid/8)%4)*2: 4 потока строки кроют 8 столбцов

    shl.b32 %r5, %r3, 3;
    add.s32 %r5, %r5, %r4;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r6, %h1;
    add.s32 %r5, %r5, 1;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r7, %h1;
    shl.b32 %r7, %r7, 16;
    or.b32 %r6, %r6, %r7;
    shl.b32 %r7, %r3, 4;
    shl.b32 %r8, %r4, 1;
    add.s64 %rd4, %rd2, %r7;
    add.s64 %rd4, %rd4, %r8;
    st.shared.b32 [%rd4], %r6;

    bar.sync 0;

    shl.b32 %r7, %r3, 4;
    add.s64 %rd5, %rd2, %r7;
    // transposed load: thread takes column elements
    ldmatrix.sync.aligned.m8n8.x1.trans.shared.b16 {%r9}, [%rd5];
    // store back to the same row layout (so the copy-out reads columns)
    shl.b32 %r7, %r3, 4;
    add.s64 %rd6, %rd3, %r7;
    stmatrix.sync.aligned.m8n8.x1.shared.b16 [%rd6], {%r9};

    bar.sync 0;

    // copy-out reads the STORE positions: row tid>>2, cols (tid%4)*2.
    and.b32 %r14, %r2, 3;
    shl.b32 %r14, %r14, 1;
    shr.u32 %r7, %r2, 2;        // store row = tid>>2
    shl.b32 %r7, %r7, 4;
    shl.b32 %r8, %r14, 1;
    add.s64 %rd4, %rd3, %r7;
    add.s64 %rd4, %rd4, %r8;
    ld.shared.b32 %r10, [%rd4];
    shl.b32 %r11, %r2, 1;
    shl.b32 %r11, %r11, 2;
    add.s64 %rd5, %rd1, %r11;
    and.b32 %r12, %r10, 65535;
    shr.u32 %r13, %r10, 16;
    cvt.u16.u32 %h2, %r12;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r13;
    cvt.f32.f16 %f3, %h3;
    st.global.f32 [%rd5], %f2;
    st.global.f32 [%rd5+4], %f3;
    ret;
}

// x4: four matrices, all four fragments delivered to EVERY thread (PTX ISA
// 9.7.16.5.15), ldmatrix.x4 -> stmatrix.x4 roundtrip, then all four matrices
// copied back out so the store placement is checked too.
.visible .entry ldmatrix_x4(
    .param .u64 ldmatrix_x4_param_0
)
{
    .reg .b16 %h<4>;
    .reg .b32 %r<20>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<4>;
    .shared .align 2 .b8 tiles_in[512];
    .shared .align 2 .b8 tiles_out[512];

    ld.param.u64 %rd1, [ldmatrix_x4_param_0];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.shared.u64 %rd2, tiles_in;
    cvta.to.shared.u64 %rd3, tiles_out;

    // Per the .num table, threads 8m..8m+7 supply matrix m's row addresses, so
    // this thread owns matrix m = tid/8 and fills row tid%8 of it completely.
    mov.u32 %r2, %tid.x;
    and.b32 %r3, %r2, 7;         // row = tid % 8
    shr.u32 %r4, %r2, 3;         // m = tid / 8 (0..3)
    shl.b32 %r6, %r4, 7;         // m*128
    shl.b32 %r7, %r3, 3;         // row*8
    add.s32 %r6, %r6, %r7;
    add.s32 %r6, %r6, 100;        // value base = m*128+100+row*8 (max 547: f16-exact)
    shl.b32 %r9, %r4, 7;         // m*128 bytes
    shl.b32 %r10, %r3, 4;        // row*16 bytes
    add.s64 %rd4, %rd2, %r9;
    add.s64 %rd4, %rd4, %r10;    // tiles_in + m*128 + row*16
    // Four columns of two elements each (col0 = 0, 2, 4, 6).
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r11, %h1;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r12, %h1;
    shl.b32 %r12, %r12, 16;
    or.b32 %r11, %r11, %r12;
    st.shared.b32 [%rd4], %r11;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r11, %h1;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r12, %h1;
    shl.b32 %r12, %r12, 16;
    or.b32 %r11, %r11, %r12;
    st.shared.b32 [%rd4+4], %r11;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r11, %h1;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r12, %h1;
    shl.b32 %r12, %r12, 16;
    or.b32 %r11, %r11, %r12;
    st.shared.b32 [%rd4+8], %r11;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r11, %h1;
    add.s32 %r6, %r6, 1;
    cvt.f32.s32 %f1, %r6;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r12, %h1;
    shl.b32 %r12, %r12, 16;
    or.b32 %r11, %r11, %r12;
    st.shared.b32 [%rd4+12], %r11;

    bar.sync 0;

    // Our matrix's row address (matrix m = tid/8, row tid%8).
    shl.b32 %r9, %r4, 7;
    shl.b32 %r10, %r3, 4;
    add.s64 %rd5, %rd2, %r9;
    add.s64 %rd5, %rd5, %r10;
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%r9, %r10, %r11, %r12}, [%rd5];

    // Store all four fragments back at the same layout. %r0/%r1 are fresh on
    // purpose: %r9-%r12 hold the loaded fragments and must survive.
    // NOTE: provider addresses always use (m=tid/8, row=tid%8) = %r4/%r3 here,
    // never the take-row tid>>2 — only takes and copy-out reads moved.
    shl.b32 %r0, %r4, 7;
    shl.b32 %r1, %r3, 4;
    add.s64 %rd6, %rd3, %r0;
    add.s64 %rd6, %rd6, %r1;
    stmatrix.sync.aligned.m8n8.x4.shared.b16 [%rd6], {%r9, %r10, %r11, %r12};

    bar.sync 0;

    // Copy out every matrix: out[k*64 + tid*2 + e], reading tiles_out at
    // k*128 + row*16 + (tid%4)*4 BYTES (column (tid%4)*2, two bytes each).
    // %r13 = column pair offset in bytes, %r14 = tid*8 bytes,
    // %r5 = store row tid>>2 (group of 4 moves one row).
    shr.u32 %r5, %r2, 2;
    and.b32 %r13, %r2, 3;
    shl.b32 %r13, %r13, 2;
    shl.b32 %r14, %r2, 1;
    shl.b32 %r14, %r14, 2;

    // --- matrix 0 ---
    shl.b32 %r0, %r5, 4;
    add.s32 %r0, %r0, %r13;
    mul.wide.u32 %rd4, %r0, 1;
    add.s64 %rd4, %rd3, %rd4;
    ld.shared.b32 %r15, [%rd4];
    mul.wide.u32 %rd5, %r14, 1;
    add.s64 %rd6, %rd1, %rd5;
    and.b32 %r16, %r15, 65535;
    shr.u32 %r17, %r15, 16;
    cvt.u16.u32 %h2, %r16;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r17;
    cvt.f32.f16 %f3, %h3;
    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd6+4], %f3;

    // --- matrix 1 ---
    mov.u32 %r0, 128;
    shl.b32 %r1, %r5, 4;
    add.s32 %r0, %r0, %r1;
    add.s32 %r0, %r0, %r13;
    mul.wide.u32 %rd4, %r0, 1;
    add.s64 %rd4, %rd3, %rd4;
    ld.shared.b32 %r15, [%rd4];
    add.s32 %r18, %r14, 256;
    mul.wide.u32 %rd5, %r18, 1;
    add.s64 %rd6, %rd1, %rd5;
    and.b32 %r16, %r15, 65535;
    shr.u32 %r17, %r15, 16;
    cvt.u16.u32 %h2, %r16;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r17;
    cvt.f32.f16 %f3, %h3;
    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd6+4], %f3;

    // --- matrix 2 ---
    mov.u32 %r0, 256;
    shl.b32 %r1, %r5, 4;
    add.s32 %r0, %r0, %r1;
    add.s32 %r0, %r0, %r13;
    mul.wide.u32 %rd4, %r0, 1;
    add.s64 %rd4, %rd3, %rd4;
    ld.shared.b32 %r15, [%rd4];
    add.s32 %r18, %r14, 512;
    mul.wide.u32 %rd5, %r18, 1;
    add.s64 %rd6, %rd1, %rd5;
    and.b32 %r16, %r15, 65535;
    shr.u32 %r17, %r15, 16;
    cvt.u16.u32 %h2, %r16;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r17;
    cvt.f32.f16 %f3, %h3;
    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd6+4], %f3;

    // --- matrix 3 ---
    mov.u32 %r0, 384;
    shl.b32 %r1, %r5, 4;
    add.s32 %r0, %r0, %r1;
    add.s32 %r0, %r0, %r13;
    mul.wide.u32 %rd4, %r0, 1;
    add.s64 %rd4, %rd3, %rd4;
    ld.shared.b32 %r15, [%rd4];
    add.s32 %r18, %r14, 768;
    mul.wide.u32 %rd5, %r18, 1;
    add.s64 %rd6, %rd1, %rd5;
    and.b32 %r16, %r15, 65535;
    shr.u32 %r17, %r15, 16;
    cvt.u16.u32 %h2, %r16;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r17;
    cvt.f32.f16 %f3, %h3;
    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd6+4], %f3;
    ret;
}

// sm_75-runnable load half: fill, ldmatrix.x1, fragment straight to global.
// No stmatrix (sm_90+), so this entry assembles AND runs on sm_75 silicon
// (MX450), proving the NVPTX inline-asm lowering on hardware. Take positions
// are the corrected mapping: row tid>>2, cols (tid%4)*2 — full tile coverage,
// every thread distinct.
.visible .entry ldmatrix_sm75(
    .param .u64 ldmatrix_sm75_param_0
)
{
    .reg .b16 %h<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<4>;
    .shared .align 2 .b8 tile_in[128];

    ld.param.u64 %rd1, [ldmatrix_sm75_param_0];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.shared.u64 %rd2, tile_in;

    mov.u32 %r2, %tid.x;
    and.b32 %r3, %r2, 7;        // fill row = tid % 8
    shr.u32 %r4, %r2, 3;        // tid / 8
    and.b32 %r4, %r4, 3;
    shl.b32 %r4, %r4, 1;        // fill col0 = ((tid/8)%4)*2 (full coverage)

    // fill input tile: in[row][col0..col0+1] = row*8+col (as f16)
    shl.b32 %r5, %r3, 3;
    add.s32 %r5, %r5, %r4;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r6, %h1;
    add.s32 %r5, %r5, 1;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r7, %h1;
    shl.b32 %r7, %r7, 16;
    or.b32 %r6, %r6, %r7;
    shl.b32 %r7, %r3, 4;
    shl.b32 %r8, %r4, 1;
    add.s64 %rd4, %rd2, %r7;
    add.s64 %rd4, %rd4, %r8;
    st.shared.b32 [%rd4], %r6;

    bar.sync 0;

    shl.b32 %r7, %r3, 4;
    add.s64 %rd5, %rd2, %r7;
    ldmatrix.sync.aligned.m8n8.x1.shared.b16 {%r9}, [%rd5];

    // fragment straight out: out[tid*2+e] as f32 (take row tid>>2).
    and.b32 %r12, %r9, 65535;
    shr.u32 %r13, %r9, 16;
    cvt.u16.u32 %h2, %r12;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r13;
    cvt.f32.f16 %f3, %h3;
    shl.b32 %r11, %r2, 1;
    shl.b32 %r11, %r11, 2;
    add.s64 %rd6, %rd1, %r11;
    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd6+4], %f3;
    ret;
}

// sm_90 store half: registers -> stmatrix.x1 -> shared -> global.
// Mirrors ldmatrix_sm75 (take row tid>>2, cols (tid%4)*2) but exercises the
// store direction. Assembles from sm_90 up (verified with ptxas); executes
// where stmatrix exists in silicon.
.visible .entry stmatrix_sm90(
    .param .u64 stmatrix_sm90_param_0
)
{
    .reg .b16 %h<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .f32 %f<4>;
    .shared .align 2 .b8 tile_out[128];

    ld.param.u64 %rd1, [stmatrix_sm90_param_0];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.shared.u64 %rd3, tile_out;

    mov.u32 %r2, %tid.x;
    // take values for (row tid>>2, cols (tid%4)*2): val = row*8+col, as f16.
    shr.u32 %r3, %r2, 2;        // take row
    and.b32 %r4, %r2, 3;
    shl.b32 %r4, %r4, 1;        // take col0
    shl.b32 %r5, %r3, 3;        // row*8
    add.s32 %r5, %r5, %r4;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r9, %h1;
    add.s32 %r5, %r5, 1;
    cvt.f32.s32 %f1, %r5;
    cvt.f16.f32 %h1, %f1;
    mov.b32 %r10, %h1;
    shl.b32 %r10, %r10, 16;
    or.b32 %r9, %r9, %r10;      // packed fragment
    // provider address: every thread supplies a valid row start (tid%8).
    and.b32 %r6, %r2, 7;
    shl.b32 %r6, %r6, 4;
    add.s64 %rd6, %rd3, %r6;
    stmatrix.sync.aligned.m8n8.x1.shared.b16 [%rd6], {%r9};

    bar.sync 0;

    // read back the store positions and copy out as f32.
    shl.b32 %r7, %r3, 4;
    shl.b32 %r8, %r4, 1;
    add.s64 %rd4, %rd3, %r7;
    add.s64 %rd4, %rd4, %r8;
    ld.shared.b32 %r10, [%rd4];
    and.b32 %r12, %r10, 65535;
    shr.u32 %r13, %r10, 16;
    cvt.u16.u32 %h2, %r12;
    cvt.f32.f16 %f2, %h2;
    cvt.u16.u32 %h3, %r13;
    cvt.f32.f16 %f3, %h3;
    shl.b32 %r11, %r2, 1;
    shl.b32 %r11, %r11, 2;
    add.s64 %rd5, %rd1, %r11;
    st.global.f32 [%rd5], %f2;
    st.global.f32 [%rd5+4], %f3;
    ret;
}
